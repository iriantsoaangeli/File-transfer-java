<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.controller.ClientController"
            prefWidth="940"
            prefHeight="680"
            style="-fx-background-color: #1e1e2e;">

    <!-- ── Titre ───────────────────────────────────────────────────────── -->
    <top>
        <VBox style="-fx-background-color: #181825; -fx-padding: 12 20 12 20;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="📡  FTPApp — Mode Client"
                       style="-fx-text-fill: #cdd6f4; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" text="● Déconnecté"
                       style="-fx-text-fill: #f38ba8; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ── Contenu ─────────────────────────────────────────────────────── -->
    <center>
        <VBox spacing="10" style="-fx-padding: 12;">

            <!-- ── Barre de connexion ─────────────────────────────────── -->
            <HBox spacing="8" alignment="CENTER_LEFT"
                  style="-fx-background-color: #181825; -fx-padding: 12; -fx-background-radius: 8;">

                <Label text="Hôte :" style="-fx-text-fill: #a6adc8;"/>
                <TextField fx:id="hostField" promptText="IP ou hostname" prefWidth="150"
                           style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #585b70;"/>

                <Label text="Port :" style="-fx-text-fill: #a6adc8;"/>
                <TextField fx:id="portField" promptText="2121" prefWidth="70"
                           style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #585b70;"/>

                <Label text="Login :" style="-fx-text-fill: #a6adc8;"/>
                <TextField fx:id="usernameField" promptText="admin" prefWidth="100"
                           style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #585b70;"/>

                <Label text="Mot de passe :" style="-fx-text-fill: #a6adc8;"/>
                <PasswordField fx:id="passwordField" promptText="••••••" prefWidth="100"
                               style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-prompt-text-fill: #585b70;"/>

                <Button fx:id="connectButton" text="🔌 Connecter" onAction="#onConnect"
                        style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; -fx-font-weight: bold;"/>
                <Button fx:id="disconnectButton" text="⏏ Déconnecter" onAction="#onDisconnect"
                        disable="true"
                        style="-fx-background-color: #f38ba8; -fx-text-fill: #1e1e2e; -fx-font-weight: bold;"/>
            </HBox>

            <!-- ── Barre d'outils fichiers ─────────────────────────────── -->
            <HBox spacing="8" alignment="CENTER_LEFT"
                  style="-fx-background-color: #181825; -fx-padding: 10 12 10 12; -fx-background-radius: 8;">

                <Label text="📂 Répertoire :"
                       style="-fx-text-fill: #a6adc8; -fx-font-size: 11px;"/>
                <Label fx:id="currentDirLabel" text="/"
                       style="-fx-text-fill: #89dceb; -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="parentDirButton" text="⬆ Parent" onAction="#onParentDirectory"
                        disable="true"
                        style="-fx-background-color: #45475a; -fx-text-fill: #cdd6f4;"/>
                <Button fx:id="refreshButton" text="🔄 Actualiser" onAction="#onRefresh"
                        disable="true"
                        style="-fx-background-color: #45475a; -fx-text-fill: #cdd6f4;"/>
                <Button fx:id="uploadButton" text="⬆ Upload" onAction="#onUpload"
                        disable="true"
                        style="-fx-background-color: #a6e3a1; -fx-text-fill: #1e1e2e; -fx-font-weight: bold;"/>
                <Button fx:id="downloadButton" text="⬇ Download" onAction="#onDownload"
                        disable="true"
                        style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e; -fx-font-weight: bold;"/>
                <Button fx:id="deleteButton" text="✖ Supprimer" onAction="#onDelete"
                        disable="true"
                        style="-fx-background-color: #f38ba8; -fx-text-fill: #1e1e2e; -fx-font-weight: bold;"/>
            </HBox>

            <!-- ── TableView fichiers ─────────────────────────────────── -->
            <TableView fx:id="fileTableView" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #181825; -fx-text-fill: #cdd6f4;">
                <placeholder>
                    <Label text="Connectez-vous pour lister les fichiers"
                           style="-fx-text-fill: #585b70;"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="nameColumn" text="Nom" prefWidth="300"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="80"/>
                    <TableColumn fx:id="sizeColumn" text="Taille" prefWidth="100"/>
                    <TableColumn fx:id="permissionsColumn" text="Permissions" prefWidth="130"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- ── Barre de progression ───────────────────────────────── -->
            <ProgressBar fx:id="progressBar" maxWidth="Infinity"
                         style="-fx-accent: #89b4fa;"/>

            <!-- ── Console logs ───────────────────────────────────────── -->
            <TitledPane text="Logs" animated="false" prefHeight="140"
                        style="-fx-text-fill: #a6adc8; -fx-background-color: #181825;">
                <TextArea fx:id="logArea" editable="false" wrapText="true"
                          prefHeight="110"
                          style="-fx-background-color: #11111b; -fx-text-fill: #a6e3a1; -fx-font-family: 'Monospace'; -fx-font-size: 11px; -fx-control-inner-background: #11111b;"/>
            </TitledPane>

        </VBox>
    </center>
</BorderPane>
